# Runtime
NODE_ENV=development
DATABASE_URL=postgresql://vexlo:vexlo@localhost:5432/vexlo?schema=public
SESSION_SECRET=replace-with-at-least-32-random-bytes
AUTH_OTP_MODE=mock
VEXLO_PROVIDER_MODE=mock
VEXLO_LIVE_PAYMENTS_ENABLED=false
VEXLO_LIVE_AGENT_PIPELINE_ENABLED=false
VEXLO_DEV_BANNER=true

# Provider credentials (server only; never expose with NEXT_PUBLIC_)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
BLINDPAY_API_KEY=
BLINDPAY_BASE_URL=https://api.blindpay.com
BLINDPAY_INSTANCE_ID=
LIGHTSPARK_API_TOKEN=
LIGHTSPARK_BASE_URL=
WISE_API_TOKEN=
WISE_BASE_URL=https://api.wise.com/2026Q4
WISE_PROFILE_ID=
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_USDC_ISSUER=
# Private signing keys must come from a KMS or vault integration. No env key fallback is implemented.
KMS_KEY_REFERENCE=

# Optional outbound mail/SMS adapters are not configured in this prototype.
SMTP_URL=
SMS_PROVIDER_URL=
